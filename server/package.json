    "cors": "^2.8.5",
    "docx": "^9.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.8.1",
    "multer": "^1.4.5-lts.1",
